{
  "mcpServers": {
    "deskquant-mcp": {
      "command": "cargo",
      "args": ["run", "--bin", "deskquant-mcp"]
    },
    "trent": {
      "command": "trent-mcp",
      "args": []
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_EXAMPLE_DO_NOT_USE_hardcoded_pat_1234567890"
      }
    }
  }
}
